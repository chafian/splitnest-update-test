{
  "name": "splitnest",
  "productName": "SplitNest",
  "version": "0.1.5-beta.1",
  "description": "Desktop terminal workspace: project folders, real PowerShell/WSL terminals, split panes.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Souf CH"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:pty": "vitest run --project pty",
    "test:wsl": "vitest run --project wsl",
    "verify:package": "node scripts/verify-package.mjs",
    "ui-icons": "node scripts/ui-icons.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/packaged-smoke.ps1",
    "licenses": "node scripts/licenses.mjs",
    "inventory": "node scripts/binary-inventory.mjs",
    "icons": "node scripts/sync-file-icons.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@lezer/highlight": "1.2.5",
    "@tabler/icons": "3.49.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "material-icon-theme": "5.38.0",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
